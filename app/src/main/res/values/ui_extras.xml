<?xml version="1.0" encoding="utf-8"?>
<!-- Extra colours, styles and strings for the updated UI. Uses the existing pantry_* palette. -->
<resources>
    <color name="pantry_cream_dark">#EFEBE0</color>
    <color name="pantry_terracotta_light">#F6DDD0</color>
    <color name="pantry_honey">#C8922E</color>
    <color name="pantry_honey_light">#FBEBC8</color>
    <color name="pantry_honey_dark">#6B4600</color>
    <color name="pantry_danger_dark">#8C1D18</color>

    <string name="nav_pantry">Pantry</string>
    <string name="nav_recipes">Recipes</string>
    <string name="nav_settings">Settings</string>

    <!-- Unit drop-down that matches Widget.Pantry.TextInput -->
    <style name="Widget.Pantry.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
    </style>

    <style name="TextAppearance.Pantry.Serif" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pantry_ink</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.Pantry.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.Pantry.HeaderTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Pantry.HeaderSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/pantry_header_subtitle</item>
    </style>

    <style name="TextAppearance.Pantry.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/pantry_green</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Pantry.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/pantry_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Pantry.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/pantry_ink</item>
    </style>

    <style name="TextAppearance.Pantry.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/pantry_muted</item>
    </style>

    <style name="TextAppearance.Pantry.EmptyState" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/pantry_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Cards -->
    <style name="Widget.Pantry.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/pantry_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Pantry.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="Widget.Pantry.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pantry_green</item>
        <item name="strokeColor">@color/pantry_green</item>
        <item name="cornerRadius">26dp</item>
    </style>

    <style name="Widget.Pantry.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/pantry_green</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Buttons that sit on the green header band -->
    <style name="Widget.Pantry.Button.OnHeader" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pantry_green</item>
        <item name="backgroundTint">@color/pantry_cream</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.Pantry.Button.OnHeaderOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.Pantry.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/white</item>
    </style>
</resources>
